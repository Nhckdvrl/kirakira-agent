{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "@akashic/web-ui-v1": [
        "packages/akashic-web-ui-v1/index.d.ts"
      ],
      "@akashic/chat-ui-v1": [
        "packages/akashic-chat-ui-v1/index.d.ts"
      ],
      "@akashic/shell-ui-v1": [
        "packages/akashic-shell-ui-v1/index.d.ts"
      ],
      "@akashic/conversation-tools-v2": [
        "packages/akashic-conversation-tools-v2/index.d.ts"
      ],
      "@/*": [
        "chat/src/*"
      ]
    },
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "dashboard/src/**/*.ts",
    "dashboard/src/**/*.tsx",
    "chat/src/**/*.ts",
    "chat/src/**/*.tsx",
    "chat/harness/**/*.tsx",
    "theme/src/**/*.ts",
    "../plugins/**/*.ts",
    "../plugins/**/*.tsx",
    "packages/**/*.d.ts",
    "types/**/*.d.ts"
  ]
}
