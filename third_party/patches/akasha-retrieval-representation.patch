+def _projection_code() -> str:
+    plugins = Path(__file__).resolve().parents[2]
+    digest = hashlib.sha256()
+    try:
+        for package in _PROJECTION_PACKAGES:
+            for path in sorted((plugins / package).rglob("*.py")):
